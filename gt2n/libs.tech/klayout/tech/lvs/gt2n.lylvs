<?xml version="1.0" encoding="utf-8"?>
<klayout-macro>
 <description>GT2N LVS deck translated from icv_runset/gt2_main.lvs.rs for ORFS/KLayout.</description>
 <version/>
 <category>lvs</category>
 <prolog/>
 <epilog/>
 <doc/>
 <autorun>false</autorun>
 <autorun-early>false</autorun-early>
 <shortcut/>
 <show-in-menu>true</show-in-menu>
 <group-name>lvs_scripts</group-name>
 <menu-path>tools_menu.lvs.end</menu-path>
 <interpreter>dsl</interpreter>
 <dsl-interpreter-name>lvs-dsl-xml</dsl-interpreter-name>
 <text><![CDATA[
# GT2N LVS deck for OpenROAD-flow-scripts
# Source intent: platforms/gt2n/icv_runset/gt2_main.lvs.rs
#
# This deck uses original ICV symbol names where possible (aM1, tM1, gPSUB, ...)
# to make line-by-line audits against gt2_main.lvs.rs straightforward.

# -----------------------------------------------------------------------------
# Inputs / outputs
# -----------------------------------------------------------------------------
def spice_pg_name?(name)
  ["vdd", "vdd!", "vss", "vss!", "gnd!", "gnd"].include?(name.to_s.downcase)
end

def spice_records(path)
  records = []
  current = []

  File.open(path, "rb") do |file|
    file.each_line do |raw_line|
      # Some concatenated CDL comments can carry non-ASCII bytes.  The LVS
      # prefilter only needs ASCII SPICE syntax, so normalize safely here.
      line = raw_line.encode("UTF-8", invalid: :replace, undef: :replace, replace: "")
      if line =~ /^\s*\+/
        current << line
      else
        records << current unless current.empty?
        current = [line]
      end
    end
  end
  records << current unless current.empty?
  records
end

def spice_record_text(lines)
  first = lines.first.to_s.chomp
  rest = lines[1..-1] || []
  rest.each do |line|
    first += " " + line.sub(/^\s*\+\s*/, "").strip
  end
  first
end

def write_spice_tokens(out, tokens, width = 160)
  return if tokens.empty?
  line = tokens.shift.dup
  tokens.each do |tok|
    if line.length + tok.length + 1 > width
      out.puts(line)
      line = "+ #{tok}"
    else
      line += " #{tok}"
    end
  end
  out.puts(line)
end

def signal_only_cdl_path(cdl_path)
  records = spice_records(cdl_path)
  gt2_keep_indices = {}
  @gt2n_signal_only_top_ports = nil

  records.each do |lines|
    text = spice_record_text(lines).strip
    next unless text =~ /^\.subckt\s+/i

    tokens = text.split
    model = tokens[1]
    formals = tokens[2..-1] || []
    if model && !model.downcase.start_with?("gt2_6t_") && @gt2n_signal_only_top_ports.nil?
      @gt2n_signal_only_top_ports = formals.reject { |pin| spice_pg_name?(pin) }
    end
    next unless model && model.downcase.start_with?("gt2_6t_")

    keep = []
    formals.each_with_index do |pin, idx|
      keep << idx unless spice_pg_name?(pin)
    end
    gt2_keep_indices[model.downcase] = keep
  end

  tmp_root = ENV["TMPDIR"] || "/tmp"
  filtered = File.join(tmp_root, "gt2n_signal_only_#{Process.pid}_#{File.basename(cdl_path)}")
  File.open(filtered, "w") do |out|
    records.each do |lines|
      text = spice_record_text(lines)
      stripped = text.strip

      if stripped =~ /^\.subckt\s+/i
        tokens = stripped.split
        model = tokens[1]
        keep = gt2_keep_indices[model.to_s.downcase]
        if keep
          formals = tokens[2..-1] || []
          write_spice_tokens(out, [tokens[0], model] + keep.map { |idx| formals[idx] })
          next
        elsif model && !model.downcase.start_with?("gt2_6t_")
          formals = tokens[2..-1] || []
          write_spice_tokens(out, [tokens[0], model] + formals.reject { |pin| spice_pg_name?(pin) })
          next
        end
      elsif stripped =~ /^x/i
        tokens = stripped.split
        model = tokens[-1]
        if model.to_s.downcase.start_with?("gt2_6t_filler")
          next
        end
        keep = gt2_keep_indices[model.to_s.downcase]
        if keep
          actuals = tokens[1...-1] || []
          write_spice_tokens(out, [tokens[0]] + keep.map { |idx| actuals[idx] } + [model])
          next
        end
      end

      lines.each { |line| out.print(line) }
    end
  end

  puts "INFO : GT2N signal-only LVS filtered CDL #{cdl_path} -> #{filtered}; stdcell_models=#{gt2_keep_indices.size}"
  filtered
end

layout_path = $in_gds || $input || $gds
raise "Missing -rd input=<layout.gds> (or -rd in_gds=<layout.gds>)" if !layout_path || layout_path.to_s.empty?
top_cell_name = $topcell || $top_cell

# Placed-and-routed blocks in transistor mode: dissolve these instances into
# the top cell before extraction (-rd lvs_flatten_cells, comma-separated cell
# name patterns, empty to disable). align then flattens the schematic circuits
# of these cells, which have no layout counterpart.
# - Fillers (no devices, tens of thousands per block): their BPR segments
#   still close the supply rails, while the hierarchical extractor and the
#   netlist purge no longer handle one subcircuit per filler. OpenROAD
#   write_cdl still lists the filler instances (the filler LEF macro is CLASS
#   CORE, not CORE SPACER).
# - The cells with two vss rails (see lvs_implicit_cells below): flat, their
#   devices sit on the nets of the block, so a rail the block leaves open is
#   a mismatch. Joining the rails inside the cell (connect_implicit) while they
#   are on different block nets runs into a use-after-free in KLayout 0.30.12
#   (connected_clusters::join_cluster_with, reached from
#   LayoutToNetlist::join_nets_from_pattern through Circuit::join_pins): such
#   runs aborted with a corrupted heap and KLayout then hung.
lvs_flatten_cells = ($lvs_flatten_cells || "gt2_6t_filler*,gt2_6t_dffasync*,gt2_6t_mux2*").to_s
lvs_flatten_cells = lvs_flatten_cells.split(/[\s,]+/).reject(&:empty?)
flatten_layout = nil
if ($lvs_mode || ENV["KLAYOUT_LVS_MODE"]).to_s.downcase == "transistor" && !lvs_flatten_cells.empty?
  ly = RBA::Layout.new(true)
  ly.read(layout_path)
  top = (top_cell_name && !top_cell_name.to_s.empty?) ? ly.cell(top_cell_name) : ly.top_cell
  raise "Top cell '#{top_cell_name}' not found in #{layout_path}" unless top
  victims = []
  top.each_inst do |inst|
    victims << inst if lvs_flatten_cells.any? { |pattern| File.fnmatch(pattern, inst.cell.name) }
  end
  unless victims.empty?
    # Copy the shapes (not the labels) in one batch: Instance#flatten updates
    # the layout after every call.
    layers = ly.layer_indexes
    shapes_of = {}
    ly.start_changes
    victims.each do |inst|
      raise "GT2N LVS: arrayed '#{inst.cell.name}' instance not supported" if inst.is_regular_array?
      content = shapes_of[inst.cell_index] ||= layers.flat_map do |li|
        list = []
        it = ly.begin_shapes(inst.cell_index, li)
        until it.at_end?
          list << [li, it.shape, it.trans] unless it.shape.is_text?
          it.next
        end
        list
      end
      t = inst.cplx_trans
      content.each { |li, shape, st| top.shapes(li).insert(shape, t * st) }
      inst.delete
    end
    ly.end_changes
    puts "INFO : GT2N flattened #{victims.size} '#{lvs_flatten_cells.join(",")}' instance(s) into #{top.name}"
    flatten_layout = top
  end
end

if flatten_layout
  source(flatten_layout)
elsif top_cell_name && !top_cell_name.to_s.empty?
  source(layout_path, top_cell_name)
else
  source(layout_path)
end

report_lvs($report_file || $report || $output || "lvs_report.lvsdb")

signal_only_lvs_requested = ($signal_only_lvs || ENV["KLAYOUT_LVS_SIGNAL_ONLY"] == "1")

# ICV ignores the bulk of the nanosheet devices (optional BULK pin with
# pin_compared = false and ignore_pins = {"BULK"}, gt2_main.lvs.rs lines
# 378-400). The layout devices are extracted as 3-terminal MOS (mos3 below),
# so read the 4-terminal CDL MOS elements (D G S B) as 3-terminal devices too.
# W is the total width (W * M), W and L in microns.
class GT2NMOS3SpiceReader < RBA::NetlistSpiceReaderDelegate
  def element(circuit, element, name, model, value, nets, params)
    return super unless element == "M" && nets.size == 4
    nl = circuit.netlist
    cls = nl.device_class_by_name(model)
    unless cls
      cls = RBA::DeviceClassMOS3Transistor.new
      cls.name = model
      nl.add(cls)
    end
    error("MOS element #{name} without W or L") unless params["W"] && params["L"]
    device = circuit.create_device(cls, name)
    device.connect_terminal("D", nets[0])
    device.connect_terminal("G", nets[1])
    device.connect_terminal("S", nets[2])
    device.set_parameter("W", params["W"] * 1e6 * (params["M"] || 1.0))
    device.set_parameter("L", params["L"] * 1e6)
    true
  end
end

$cdl_file ||= $netlist
if $cdl_file
  ref_cdl_file = signal_only_lvs_requested ? signal_only_cdl_path($cdl_file) : $cdl_file
  schematic(ref_cdl_file, RBA::NetlistSpiceReader.new(GT2NMOS3SpiceReader.new))
elsif $schematic
  ref_cdl_file = signal_only_lvs_requested ? signal_only_cdl_path($schematic) : $schematic
  schematic(ref_cdl_file, RBA::NetlistSpiceReader.new(GT2NMOS3SpiceReader.new))
else
  raise "Missing -rd cdl_file=<reference.cdl> (or -rd schematic=<reference.cdl>)"
end

spice_with_net_names = true
spice_with_comments = false

lvs_mode = ($lvs_mode || ENV["KLAYOUT_LVS_MODE"] || "abstract").to_s.downcase
unless ["abstract", "transistor"].include?(lvs_mode)
  raise "Unsupported LVS mode '#{lvs_mode}'. Use -rd lvs_mode=abstract or -rd lvs_mode=transistor."
end

if $target_netlist
  target_netlist($target_netlist, write_spice(spice_with_net_names, spice_with_comments),
                 "Extracted by KLayout GT2N LVS on #{Time.now.strftime("%Y-%m-%d %H:%M")}")
end

deep
thread_count = ($threads || ENV["KLAYOUT_LVS_THREADS"] || ENV["NUM_CORES"] || "8").to_i
thread_count = 1 if thread_count < 1
threads(thread_count)
verbose(true)
puts "INFO : GT2N LVS mode = #{lvs_mode}"
puts "INFO : GT2N LVS threads = #{thread_count}"

if lvs_mode == "abstract" && signal_only_lvs_requested
  # The filler cells carry only supply rails, which signal-only LVS leaves
  # out; signal_only_cdl_path drops the filler instances from the schematic.
  select("-gt2_6t_filler*")
  puts "INFO : GT2N signal-only abstract LVS source filter = -gt2_6t_filler*"
end

# -----------------------------------------------------------------------------
# ICV header traceability (gt2_main.lvs.rs lines 32-37)
# -----------------------------------------------------------------------------
# #define ICV_ENABLE_LVS_SEN_EXCLUDE_TOLERANCE
# #include <icv.rh>
# #ifdef OVERRIDE_FILE
# #include "override_file.rs"
# #endif

vLVS_POWER_NAMES  = ["VDD", "vdd", "vdd!", "VDD!"]
vLVS_GROUND_NAMES = ["VSS", "GND!", "gnd!", "vss", "vss!", "VSS!", "Vss!"]

# -----------------------------------------------------------------------------
# Layer name mapping (ICV assign/assign_text)
# -----------------------------------------------------------------------------
if lvs_mode == "transistor"
  aNWELL  = polygons(1, 0)
  aACT    = polygons(2, 0)
  aGATE   = polygons(3, 0)
  aDUMMY  = polygons(4, 0)
  aGCUT   = polygons(5, 0)
  aNSEL   = polygons(6, 0)
  aPSEL   = polygons(7, 0)
end

aBPR    = polygons(8, 0)
tBPR    = labels("8/*")
aVBPR   = polygons(9, 0)
aSDCON  = polygons(10, 0)
tSDCON  = labels("10/*")
aVSD    = polygons(11, 0)
if lvs_mode == "transistor"
  aVG     = polygons(12, 0)
end

aM0     = polygons(20, 0)
tM0     = labels("20/*")
aV0     = polygons(22, 0)
aM1     = polygons(25, 0)
tM1     = labels("25/*")
aV1     = polygons(27, 0)
aM2     = polygons(30, 0)
tM2     = labels("30/*")
aV2     = polygons(32, 0)
aM3     = polygons(35, 0)
tM3     = labels("35/*")
aV3     = polygons(37, 0)
aM4     = polygons(40, 0)
tM4     = labels("40/*")
aV4     = polygons(42, 0)
aM5     = polygons(45, 0)
tM5     = labels("45/*")
aV5     = polygons(47, 0)
aM6     = polygons(50, 0)
tM6     = labels("50/*")
aV6     = polygons(52, 0)
aM7     = polygons(55, 0)
tM7     = labels("55/*")
aV7     = polygons(57, 0)
aM8     = polygons(60, 0)
tM8     = labels("60/*")
aV8     = polygons(62, 0)
aM9     = polygons(65, 0)
tM9     = labels("65/*")
aV9     = polygons(67, 0)
aM10    = polygons(70, 0)
tM10    = labels("70/*")
aV10    = polygons(72, 0)
aM11    = polygons(75, 0)
tM11    = labels("75/*")
aV11    = polygons(77, 0)
aM12    = polygons(80, 0)
tM12    = labels("80/*")
aV12    = polygons(82, 0)
aM13    = polygons(85, 0)
tM13    = labels("85/*")
aV13    = polygons(87, 0)
aRDL    = polygons(90, 0)
tRDL    = labels("90/*")

if lvs_mode == "transistor"
  aELVT   = polygons(94, 0)
  aULVT   = polygons(95, 0)
  aSVT    = polygons(96, 0)
  aHVT    = polygons(97, 0)
  aSRAMVT = polygons(98, 0)
end

aBV0    = polygons(910, 0)
aBM1    = polygons(920, 0)
tBM1    = labels("920/*")
aBV1    = polygons(930, 0)
aBM2    = polygons(940, 0)
tBM2    = labels("940/*")
aBV2    = polygons(950, 0)
aBM3    = polygons(960, 0)
tBM3    = labels("960/*")
aBV3    = polygons(970, 0)
aBM4    = polygons(980, 0)
tBM4    = labels("980/*")
aBV4    = polygons(990, 0)
aBRDL   = polygons(1000, 0)
tBRDL   = labels("1000/*")

# -----------------------------------------------------------------------------
# Derived FEOL layers (ICV lines 180-200)
#
# Only transistor LVS needs these expensive active/gate booleans.  Full-chip
# abstract LVS checks routed cell-level connectivity through metal/via/text
# layers and deliberately skips MOS recognition inside standard cells.
# -----------------------------------------------------------------------------
if lvs_mode == "transistor"
  # ICV uses gBULK = cell_extent(...); for KLayout LVS extraction this deck uses
  # active-domain substrate/well partitions.
  gPSUB = aACT - aNWELL
  gNWELL = aNWELL

  gPOLY = aGATE - aGCUT - aDUMMY

  gN_ACTIVE_AREA = gPSUB & aACT
  gN_NS_AREA = gN_ACTIVE_AREA & aNSEL
  NGATE1 = gN_NS_AREA & gPOLY
  N_src_drn = gN_NS_AREA - NGATE1 - aDUMMY
  gN_GATE_cont = gPOLY - NGATE1

  gP_ACTIVE_AREA = gNWELL & aACT
  gP_NS_AREA = gP_ACTIVE_AREA & aPSEL
  PGATE1 = gP_NS_AREA & gPOLY
  P_src_drn = gP_NS_AREA - PGATE1 - aDUMMY
  gP_GATE_cont = gPOLY - PGATE1

  gVPW1 = aPSEL & aACT
  gVPW = gVPW1 & gPSUB
  gVNW1 = aNSEL & aSDCON
  gVNW = gVNW1 & gNWELL
end

# -----------------------------------------------------------------------------
# Connectivity (ICV incremental_connect block lines 203-237)
# -----------------------------------------------------------------------------
if lvs_mode == "transistor"
  connect(gPOLY, aVG)
  connect(aVG, aM0)
end

connect(aBRDL, aBV4)
connect(aBV4, aBM4)
connect(aBM4, aBV3)
connect(aBV3, aBM3)
connect(aBM3, aBV2)
connect(aBV2, aBM2)
connect(aBM2, aBV1)
connect(aBV1, aBM1)
connect(aBM1, aBV0)
connect(aBV0, aBPR)
connect(aBPR, aVBPR)
connect(aVBPR, aSDCON)
connect(aSDCON, aVSD)
connect(aVSD, aM0)

connect(aM0, aV0)
connect(aV0, aM1)
connect(aM1, aV1)
connect(aV1, aM2)
connect(aM2, aV2)
connect(aV2, aM3)
connect(aM3, aV3)
connect(aV3, aM4)
connect(aM4, aV4)
connect(aV4, aM5)
connect(aM5, aV5)
connect(aV5, aM6)
connect(aM6, aV6)
connect(aV6, aM7)
connect(aM7, aV7)
connect(aV7, aM8)
connect(aM8, aV8)
connect(aV8, aM9)
connect(aM9, aV9)
connect(aV9, aM10)
connect(aM10, aV10)
connect(aV10, aM11)
connect(aM11, aV11)
connect(aV11, aM12)
connect(aM12, aV12)
connect(aV12, aM13)
connect(aM13, aV13)
connect(aV13, aRDL)

if lvs_mode == "transistor"
  connect(aSDCON, N_src_drn)
  connect(aSDCON, P_src_drn)
  connect(aSDCON, gVPW)
  connect(aSDCON, gVNW)

  connect(gN_GATE_cont, NGATE1)
  connect(gN_GATE_cont, aVG)
  connect(gP_GATE_cont, PGATE1)
  connect(gP_GATE_cont, aVG)
  connect(PGATE1, gN_GATE_cont)
  connect(NGATE1, gP_GATE_cont)
end

# -----------------------------------------------------------------------------
# Text attachment / ports
# ICV uses text_origin + create_ports + text_net (lines 239-348). KLayout LVS
# has no direct equivalent API surface for those exact calls; map text labels by
# direct connectivity to conductive layers.
# -----------------------------------------------------------------------------
connect(aBRDL, tBRDL)
connect(aBM4, tBM4)
connect(aBM3, tBM3)
connect(aBM2, tBM2)
connect(aBM1, tBM1)
connect(aBPR, tBPR)
connect(aM0, tM0)
connect(aM1, tM1)
connect(aM2, tM2)
connect(aM3, tM3)
connect(aM4, tM4)
connect(aM5, tM5)
connect(aM6, tM6)
connect(aM7, tM7)
connect(aM8, tM8)
connect(aM9, tM9)
connect(aM10, tM10)
connect(aM11, tM11)
connect(aM12, tM12)
connect(aM13, tM13)
connect(aRDL, tRDL)

# -----------------------------------------------------------------------------
# Supply nets
#
# No global bulk nets: like ICV, the devices have no bulk terminal (see
# GT2NMOS3SpiceReader), so the supply nets come only from the drawn rails,
# vias and labels, and a cell whose rails do not reach the labelled supply is
# reported.
#
# The flip-flop and mux cells are double height with a vss BPR rail at the
# bottom and at the top; only the PDN of the block connects the two. Join
# same-named supply labels inside these cells only (-rd lvs_implicit_cells,
# comma-separated cell name patterns, empty to disable). They are the only
# GT2N cells with two rails of the same supply. Joining labels in other cells
# would hide opens, e.g. in a tap cell (M1 pins and BPR rails both labelled)
# with a broken via stack. In transistor mode their instances in a block are
# flattened instead (lvs_flatten_cells), so the join applies to a run of the
# cell alone and to abstract mode. Signal-only LVS (signal_only_lvs) leaves
# the supplies out of the compare and joins nothing.
# -----------------------------------------------------------------------------
lvs_ground_net = ($lvs_ground_net || "vss").to_s
lvs_power_net = ($lvs_power_net || "vdd").to_s
lvs_implicit_cells = ($lvs_implicit_cells || "gt2_6t_dffasync*,gt2_6t_mux2*").to_s.split(/[\s,]+/).reject(&:empty?)
lvs_implicit_cells = [] if signal_only_lvs_requested
lvs_implicit_cells.each do |pattern|
  connect_implicit(pattern, lvs_ground_net)
  connect_implicit(pattern, lvs_power_net)
end

# -----------------------------------------------------------------------------
# VT split and extraction (ICV lines 353-405)
#
# transistor mode follows the ICV MOS extraction intent and compares standard
# cell internals.  On large ORFS designs this can be expensive.
#
# abstract mode is the default full-chip mode: it keeps the same layer/text
# connectivity graph but blanks gt2_6t_* standard-cell circuits on both layout
# and schematic sides.  This verifies routed top-level connectivity against the
# gate-level netlist while relying on separately validated standard-cell CDL/GDS.
# -----------------------------------------------------------------------------
if lvs_mode == "transistor"
  N_base = NGATE1 & gPSUB
  P_base = PGATE1 & gNWELL

  N_ELVT = N_base & aELVT
  N_ULVT = N_base & aULVT
  N_SVT = N_base & aSVT
  N_HVT = N_base & aHVT
  N_SRAMVT = N_base & aSRAMVT
  N_LVT = N_base - aELVT - aULVT - aSVT - aHVT - aSRAMVT

  P_ELVT = P_base & aELVT
  P_ULVT = P_base & aULVT
  P_SVT = P_base & aSVT
  P_HVT = P_base & aHVT
  P_SRAMVT = P_base & aSRAMVT
  P_LVT = P_base - aELVT - aULVT - aSVT - aHVT - aSRAMVT

  # Device dimensions in microns to match CDL W/L units. No bulk terminal
  # (ICV: BULK pin_compared = false, ignore_pins = {"BULK"}).

  extract_devices(mos3("nmos_elvt"),   { "SD" => N_src_drn, "G" => N_ELVT,   "tS" => N_src_drn, "tD" => N_src_drn, "tG" => gPOLY })
  extract_devices(mos3("nmos_ulvt"),   { "SD" => N_src_drn, "G" => N_ULVT,   "tS" => N_src_drn, "tD" => N_src_drn, "tG" => gPOLY })
  extract_devices(mos3("nmos_svt"),    { "SD" => N_src_drn, "G" => N_SVT,    "tS" => N_src_drn, "tD" => N_src_drn, "tG" => gPOLY })
  extract_devices(mos3("nmos_hvt"),    { "SD" => N_src_drn, "G" => N_HVT,    "tS" => N_src_drn, "tD" => N_src_drn, "tG" => gPOLY })
  extract_devices(mos3("nmos_sramvt"), { "SD" => N_src_drn, "G" => N_SRAMVT, "tS" => N_src_drn, "tD" => N_src_drn, "tG" => gPOLY })
  extract_devices(mos3("nmos_lvt"),    { "SD" => N_src_drn, "G" => N_LVT,    "tS" => N_src_drn, "tD" => N_src_drn, "tG" => gPOLY })

  extract_devices(mos3("pmos_elvt"),   { "SD" => P_src_drn, "G" => P_ELVT,   "tS" => P_src_drn, "tD" => P_src_drn, "tG" => gPOLY })
  extract_devices(mos3("pmos_ulvt"),   { "SD" => P_src_drn, "G" => P_ULVT,   "tS" => P_src_drn, "tD" => P_src_drn, "tG" => gPOLY })
  extract_devices(mos3("pmos_svt"),    { "SD" => P_src_drn, "G" => P_SVT,    "tS" => P_src_drn, "tD" => P_src_drn, "tG" => gPOLY })
  extract_devices(mos3("pmos_hvt"),    { "SD" => P_src_drn, "G" => P_HVT,    "tS" => P_src_drn, "tD" => P_src_drn, "tG" => gPOLY })
  extract_devices(mos3("pmos_sramvt"), { "SD" => P_src_drn, "G" => P_SRAMVT, "tS" => P_src_drn, "tD" => P_src_drn, "tG" => gPOLY })
  extract_devices(mos3("pmos_lvt"),    { "SD" => P_src_drn, "G" => P_LVT,    "tS" => P_src_drn, "tD" => P_src_drn, "tG" => gPOLY })
end

if lvs_mode == "abstract"
  # Declare standard cells as abstract before extraction so KLayout can avoid
  # spending time deriving their transistor-level internals.
  #
  # KLayout's SPICE reader normalizes CDL subcircuit names to upper case in the
  # reference netlist, while GDS cell names remain lower case.  Blank both forms
  # so full-chip LVS compares standard-cell pins/top-level routing rather than
  # trying to match transistor internals for one side of the comparison.
  blank_circuit("gt2_6t_*")
  blank_circuit("GT2_6T_*")
end

def normalize_def_inst_name(name)
  # DEF/CDL escape bus brackets with backslashes, but KLayout's SPICE reader
  # stores the logical names without those escapes.
  name.gsub("\\[", "[").gsub("\\]", "]")
end

def def_mirror_flag(orient)
  # OpenROAD standard-cell rows use N and FS in this GT2N flow.  Include common
  # mirrored DEF orientations for completeness.
  ["FN", "FS", "W", "FE"].include?(orient)
end

def load_gds_master_place_heights(gds_file, def_units)
  heights = {}
  return heights unless gds_file && File.exist?(gds_file)

  # DEF records the lower-left placement point.  Mirrored GDS instances use a
  # transformed origin shifted upward by the cell placement height.  For these
  # GT2N cells the placement height is bbox.top + bbox.bottom because the GDS
  # standard-cell geometries intentionally overhang the abstract site by the
  # same amount above and below.
  layout = RBA::Layout::new
  layout.read(gds_file)
  scale = layout.dbu * def_units
  top = layout.top_cell
  top.each_inst do |inst|
    master = layout.cell(inst.cell_index).name.downcase
    next unless master.start_with?("gt2_6t_")
    next if heights.key?(master)
    bbox = layout.cell(inst.cell_index).bbox
    heights[master] = ((bbox.top + bbox.bottom) * scale).round
  end
  heights
end

def load_def_instance_name_map(def_file, def_units_box, place_heights)
  name_map = Hash.new { |h, k| h[k] = [] }
  in_components = false
  pending = nil

  File.foreach(def_file) do |raw|
    line = raw.strip
    if line.start_with?("UNITS DISTANCE MICRONS")
      toks = line.split
      def_units_box.replace(toks[3]) if toks.size >= 4
    end
    if line.start_with?("COMPONENTS ")
      in_components = true
      next
    end
    break if in_components && line == "END COMPONENTS"
    next unless in_components

    if line.start_with?("- ")
      pending = line
    elsif pending
      pending += " " + line
    else
      next
    end

    next unless pending.include?(";")
    rec = pending
    pending = nil

    m = rec.match(/^[-]\s+(\S+)\s+(\S+)\s+.*\+\s+(?:PLACED|FIXED)\s+\(\s+(\d+)\s+(\d+)\s+\)\s+(\S+)/)
    next unless m
    inst = normalize_def_inst_name(m[1])
    master = m[2].downcase
    next unless master.start_with?("gt2_6t_")
    x = m[3].to_i
    y = m[4].to_i
    mirror = def_mirror_flag(m[5])
    gds_y = mirror ? y + place_heights.fetch(master, 0) : y
    name_map[[master, x, gds_y, mirror]] << inst
  end
  name_map
end

def load_def_inst_pin_net_map(def_file)
  pin_nets = {}
  in_nets = false
  pending = nil

  File.foreach(def_file) do |raw|
    line = raw.strip
    if line.start_with?("NETS ")
      in_nets = true
      next
    end
    break if in_nets && line == "END NETS"
    next unless in_nets

    if line.start_with?("- ")
      pending = line
    elsif pending
      pending += " " + line
    else
      next
    end

    next unless pending.include?(";")
    rec = pending
    pending = nil

    m = rec.match(/^[-]\s+(\S+)/)
    next unless m
    net = normalize_def_inst_name(m[1]).upcase
    rec.scan(/\(\s+(\S+)\s+(\S+)\s+\)/) do |inst, pin|
      next if inst == "PIN"
      pin_nets[[normalize_def_inst_name(inst), pin]] = net
    end
  end

  pin_nets
end

def def_pin_net_for(pin_nets, inst, pin)
  [pin, pin.upcase, pin.downcase].uniq.each do |candidate|
    net = pin_nets[[inst, candidate]]
    return net if net
  end
  nil
end

def apply_def_net_names(layout_netlist, pin_nets, allowed_net_names = nil)
  top = layout_netlist.top_circuit
  renamed = 0
  missing = 0
  conflicts = 0
  skipped_internal = 0
  allowed = nil
  if allowed_net_names && !allowed_net_names.empty?
    allowed = {}
    allowed_net_names.each { |name| allowed[name.to_s.upcase] = true }
  end

  top.each_subcircuit do |subckt|
    cref = subckt.circuit_ref
    next if cref.nil?
    master = cref.name.downcase
    next unless master.start_with?("gt2_6t_")
    next if master.start_with?("gt2_6t_filler")

    (0...cref.pin_count).each do |i|
      pin = cref.pin_by_id(i)
      next unless pin
      def_net = def_pin_net_for(pin_nets, subckt.name, pin.name)
      if !def_net && pin.name.downcase == "vdd"
        def_net = "VDD"
      elsif !def_net && pin.name.downcase == "vss"
        def_net = "VSS"
      end
      if def_net
        if allowed && !allowed[def_net.upcase]
          skipped_internal += 1
          next
        end
        net = subckt.net_for_pin(i) rescue nil
        next unless net
        if net.name && !net.name.empty? && !net.name.start_with?("$") && net.name.upcase != def_net.upcase
          conflicts += 1
        else
          net.name = def_net
          renamed += 1
        end
      elsif pin.name.downcase != "vdd" && pin.name.downcase != "vss"
        missing += 1
      end
    end
  end

  puts "INFO : GT2N DEF net-name recovery renamed_pins=#{renamed} missing_signal_pins=#{missing} conflicts=#{conflicts} skipped_internal=#{skipped_internal}"
end

def remove_signal_lvs_pg_interface_pins(layout_netlist)
  # Signal-only abstract LVS deliberately ignores PG interface pins because
  # GT2N's BPR/PG routing is the known unresolved issue.  This keeps all signal
  # pins in KLayout's extracted GDS order, but removes vdd/vss pins from the
  # top circuit and all standard-cell abstract circuits so the comparison is not
  # dominated by fragmented physical VDD/VSS shapes.
  top = layout_netlist.top_circuit
  removed = Hash.new(0)
  subckts_by_master = Hash.new { |h, k| h[k] = [] }

  layout_netlist.each_circuit do |circuit|
    circuit.each_subcircuit do |subckt|
      begin
        cref = subckt.circuit_ref
      rescue
        begin
          cref = subckt.circuit
        rescue
          cref = nil
        end
      end
      next unless cref
      subckts_by_master[cref.name.to_s.downcase] << subckt
    end
  end

  layout_netlist.each_circuit do |circuit|
    name = circuit.name.to_s.downcase
    next unless circuit == top || name.start_with?("gt2_6t_")
    pg_pins = []
    circuit.each_pin do |pin|
      pg_pins << pin if ["vdd", "vss"].include?(pin.name.to_s.downcase)
    end
    next if pg_pins.empty?

    pg_pins.sort_by { |pin| -pin.id }.each do |pin|
      subckts_by_master[name].each do |subckt|
        begin
          subckt.disconnect_pin(pin.id)
        rescue
        end
      end

      begin
        circuit.disconnect_pin(pin.id)
      rescue
      end
      begin
        circuit.remove_pin(pin.id)
        removed[name] += 1
      rescue
      end
    end
  end

  total = removed.values.inject(0, :+)
  puts "INFO : GT2N signal-only LVS removed PG interface pins total=#{total} circuits=#{removed.size}"
end

def keep_only_signal_lvs_top_pins(layout_netlist, reference_top_ports)
  return if reference_top_ports.nil? || reference_top_ports.empty?

  top = layout_netlist.top_circuit
  keep = {}
  reference_top_ports.each { |port| keep[port.to_s.upcase] = port.to_s }
  kept = 0
  removed = 0
  renamed = 0
  pins = []
  top.each_pin { |pin| pins << pin }

  pins.sort_by { |pin| -pin.id }.each do |pin|
    key = pin.name.to_s.upcase
    canonical = keep[key]
    if canonical
      begin
        if pin.name.to_s != canonical
          pin.name = canonical
          renamed += 1
        end
      rescue
      end
      kept += 1
      next
    end

    begin
      top.disconnect_pin(pin.id)
    rescue
    end
    begin
      top.remove_pin(pin.id)
      removed += 1
    rescue
    end
  end

  puts "INFO : GT2N signal-only LVS top pins kept=#{kept} removed_internal=#{removed} renamed=#{renamed} reference_ports=#{reference_top_ports.size}"
end

def apply_def_instance_names(layout_netlist, def_file, gds_file)
  def_units_box = "2000"
  place_heights = load_gds_master_place_heights(gds_file, def_units_box.to_i)
  name_map = load_def_instance_name_map(def_file, def_units_box, place_heights)
  def_units = def_units_box.to_i
  top = layout_netlist.top_circuit
  renamed = 0
  missed = 0
  duplicate_keys = 0

  top.each_subcircuit do |subckt|
    cref = subckt.circuit_ref
    next if cref.nil?
    master = cref.name.downcase
    next unless master.start_with?("gt2_6t_")
    next if master.start_with?("gt2_6t_filler")
    tr = subckt.trans
    key = [master, (tr.disp.x * def_units).round, (tr.disp.y * def_units).round, tr.is_mirror?]
    names = name_map[key]
    if names && !names.empty?
      duplicate_keys += 1 if names.size > 1
      subckt.name = names.shift
      renamed += 1
    else
      missed += 1
    end
  end

  puts "INFO : GT2N DEF instance-name recovery renamed=#{renamed} missed=#{missed} duplicate_keys=#{duplicate_keys} def_units=#{def_units} height_masters=#{place_heights.size}"
end

begin
  netlist
rescue
  # Extraction errors, e.g. a rail of a split-rail cell with no connection at
  # all ("Must-connect subnet ... does not have any pin at all").
  puts "ERROR : Netlist extraction failed"
  puts "ERROR : Netlists don't match"
  raise
end

# Supply checks that the compare alone does not make. Errors are printed,
# added to the report and make the run fail.
gt2n_lvs_errors = []
def gt2n_lvs_error(errors, l2n, cell_name, message)
  puts "ERROR : #{message}"
  errors << message
  entry = RBA::LogEntryData.new
  entry.severity = RBA::Severity::Error
  entry.category_name = "GT2N_SUPPLY"
  entry.cell_name = cell_name.to_s
  entry.message = message
  l2n.add_log_entry(entry)
end

def gt2n_label_names(net)
  net ? net.name.to_s.downcase.split(/[|,]/).reject(&:empty?) : []
end

# Split-rail cells (lvs_implicit_cells) in a block (abstract mode, or not
# flattened): when the block does not connect all rails of an instance,
# KLayout still joins them through the implicit connection and only warns on
# the parent cell ("must be connected further up in the hierarchy"). That is
# a supply open. In a run of the split-rail cell alone the warning is on the
# cell itself and expected.
must_connect = []
lvs_data.each_log_entry do |entry|
  next unless entry.category_name == "must-connect"
  next if lvs_implicit_cells.any? { |pattern| File.fnmatch(pattern, entry.cell_name, File::FNM_CASEFOLD) }
  must_connect << entry
end
must_connect.each do |entry|
  gt2n_lvs_error(gt2n_lvs_errors, lvs_data, entry.cell_name,
                 "Split supply rails not connected in #{entry.cell_name}: #{entry.message.gsub(/\s*\n\s*/, " ")}")
end

if lvs_mode == "abstract" && $def_file
  apply_def_instance_names(netlist, $def_file, ($in_gds || $input))
  signal_only_lvs_active = ($signal_only_lvs || ENV["KLAYOUT_LVS_SIGNAL_ONLY"] == "1")
  allowed_top_nets = signal_only_lvs_active ? @gt2n_signal_only_top_ports : nil
  apply_def_net_names(netlist, load_def_inst_pin_net_map($def_file), allowed_top_nets)
  if signal_only_lvs_active
    keep_only_signal_lvs_top_pins(netlist, @gt2n_signal_only_top_ports)
    remove_signal_lvs_pg_interface_pins(netlist)
  end
end
# Dummy transistors (gate net floating, e.g. the active/gate stubs in the
# tap cells) are not part of the reference CDL. Drop them before comparing.
def remove_floating_gate_devices(nl)
  removed = 0
  nl.each_circuit do |circuit|
    victims = []
    circuit.each_device do |device|
      gate = device.net_for_terminal(1)
      next unless gate
      # Labelled nets are real signals even before top-level pins exist.
      next if gate.pin_count > 0 || gate.subcircuit_pin_count > 0 || !gate.name.to_s.empty?
      only_gates = true
      gate.each_terminal { |t| only_gates = false unless t.terminal_id == 1 }
      victims << device if only_gates
    end
    victims.each { |d| circuit.remove_device(d) }
    removed += victims.size
  end
  puts "INFO : GT2N removed #{removed} floating-gate dummy device(s)"
end

if lvs_mode == "transistor" && ($keep_floating_gate_devices || "0").to_s != "1"
  remove_floating_gate_devices(netlist)
end

# The standard-cell layouts are flat, but some cell CDLs instantiate other
# cells (dffasync is built from nand3). In a block that also uses those cells
# directly, align would keep the nested instances, so flatten the reference
# standard cells down to devices here.
if lvs_mode == "transistor"
  flattened = 0
  schematic.each_circuit do |circuit|
    next unless File.fnmatch("gt2_6t_*", circuit.name, File::FNM_CASEFOLD)
    loop do
      subs = []
      circuit.each_subcircuit { |sc| subs << sc }
      break if subs.empty?
      subs.each { |sc| circuit.flatten_subcircuit(sc) }
      flattened += subs.size
    end
  end
  puts "INFO : GT2N flattened #{flattened} nested standard-cell instance(s) in the schematic"
end

# Device-less cells (filler, tap cells) have empty CDL subcircuits and are
# purged on both sides before the compare, so the compare checks nothing of
# them. For such a top cell check the supplies instead: each supply label
# forms exactly one net (a tap cell with a broken BPR-to-M1 via stack has two)
# and no net carries both.
if lvs_mode == "transistor"
  layout_top = netlist.top_circuit
  if layout_top && layout_top.each_device.to_a.empty? && layout_top.each_subcircuit.to_a.empty?
    supplies = [lvs_power_net, lvs_ground_net].map(&:downcase)
    errors_before = gt2n_lvs_errors.size
    net_count = Hash.new(0)
    layout_top.each_net do |net|
      names = gt2n_label_names(net) & supplies
      names.each { |name| net_count[name] += 1 }
      if names.size > 1
        gt2n_lvs_error(gt2n_lvs_errors, lvs_data, layout_top.name,
                       "Supply short in device-less cell #{layout_top.name}: net #{net.name}")
      end
    end
    supplies.each do |name|
      next if net_count[name] == 1
      gt2n_lvs_error(gt2n_lvs_errors, lvs_data, layout_top.name,
                     "Supply #{name} of device-less cell #{layout_top.name} forms #{net_count[name]} nets (expected 1)")
    end
    if gt2n_lvs_errors.size == errors_before
      puts "INFO : GT2N device-less cell #{layout_top.name}: supply check passed (#{supplies.join(", ")})"
    end
  end
end

align
netlist.simplify
# Device-less circuits (filler, tap cells) are purged by simplify on the
# layout side; purge them from the reference as well in transistor mode.
schematic.simplify if lvs_mode == "transistor"

# ICV compares W and L exactly (check_property with {{"W"}, {"L"}} and no
# tolerance, gt2_main.lvs.rs lines 412-420). At this node 1 nm is 7% of the
# 14 nm gate length and 8% of a 13 nm sheet; the tolerance below only absorbs
# floating-point noise (0.01 nm, a tenth of the database unit).
if lvs_mode == "transistor"
  ["nmos", "pmos"].each do |type|
    ["elvt", "ulvt", "svt", "hvt", "sramvt", "lvt"].each do |vt|
      tolerance("#{type}_#{vt}", "W", :absolute => 0.01.nm)
      tolerance("#{type}_#{vt}", "L", :absolute => 0.01.nm)
    end
  end
end

lvs_ok = compare

# Supply guard. The compare pairs nets by topology only: when the cell rails
# are cut off from the labelled supply (e.g. a tap cell without VBPR in a
# small block), the labelled net floats and is purged, and the rail net still
# pairs with the schematic supply. Require each top-level supply net of the
# schematic to pair with a layout net labelled as the same kind of supply
# (vLVS_POWER_NAMES / vLVS_GROUND_NAMES), and the other way round.
if lvs_ok && !signal_only_lvs_requested
  power_names = (vLVS_POWER_NAMES + [lvs_power_net]).map(&:downcase)
  ground_names = (vLVS_GROUND_NAMES + [lvs_ground_net]).map(&:downcase)
  supply_kind = lambda do |net|
    names = gt2n_label_names(net)
    kind = []
    kind << "power" if (names & power_names).size > 0
    kind << "ground" if (names & ground_names).size > 0
    kind.empty? ? nil : kind.join("+")
  end
  layout_top = netlist.top_circuit
  xref = lvs_data.xref
  top_pair = nil
  xref.each_circuit_pair do |cp|
    top_pair = cp if layout_top && cp.first && cp.first.name == layout_top.name
  end
  if top_pair
    devices = xref.each_device_pair(top_pair).to_a.size
    subcircuits = xref.each_subcircuit_pair(top_pair).to_a.size
    puts "INFO : GT2N top circuit #{layout_top.name}: #{devices} device pair(s), #{subcircuits} subcircuit pair(s) compared"
    xref.each_net_pair(top_pair) do |np|
      layout_kind = supply_kind.call(np.first)
      schematic_kind = supply_kind.call(np.second)
      next if layout_kind == schematic_kind
      layout_name = np.first ? np.first.expanded_name : "(none)"
      schematic_name = np.second ? np.second.expanded_name : "(none)"
      gt2n_lvs_error(gt2n_lvs_errors, lvs_data, layout_top.name,
                     "Supply net mismatch in #{layout_top.name}: schematic net #{schematic_name} " +
                     "(#{schematic_kind || "no supply"}) pairs with layout net #{layout_name} " +
                     "(#{layout_kind || "no supply label"})")
    end
  else
    puts "INFO : GT2N top circuit: nothing compared (no devices)"
  end
end

if !lvs_ok || !gt2n_lvs_errors.empty?
  puts "ERROR : Netlists don't match"
else
  puts "INFO : Congratulations! Netlists match."
end

# -----------------------------------------------------------------------------
# ICV-only constructs preserved as traceability notes (not executable in KLayout
# LVS DSL with identical API names):
#   - dev_properties : function ... dev_polygon_perim/dev_touch_length
#       dev_recognition_layer(...)
#       dev_pin(...)
#       dev_save_double_properties(...)
#   - library(...), text_options(...), net_options(...)
#   - CONNECT_DB : connect_database = NULL_CONNECT_DATABASE
#   - text_origin(...), create_ports(...), text_net(...)
#   - init_device_matrix(...), device_db = extract_devices(dev_matrix)
#   - init_compare_matrix(), merge_parallel(), check_property(), match(...)
#   - full PEX block:
#       init_pex_layer_matrix(...)
#       pex_conducting_layer_map(...)
#       pex_via_layer_map(...)
#       pex_library_layer_map_file(...)
#       pex_cell_extents_file(...)
#       pex_cell_port_file(...)
#       gds_library(...)
#       spice_netlist_file(...)
#       pex_process_map_file(...)
#       pex_runset_report_file(...)
#       pex_generate_database(...)
# For exact API behavior of those calls, keep using the original ICV runset:
# platforms/gt2n/icv_runset/gt2_main.lvs.rs
]]></text>
</klayout-macro>
